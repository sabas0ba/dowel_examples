# 同名の2つが、同じソースを持つ。可搬な実装をライブラリにも実行ファイルにも
# 入れる形であり、実際のアプリでは理由がある書き方である。
#
# オブジェクトの経路は `obj/<パッケージ>/<ターゲット名>/` であり、種別が
# 入らない。同名の2つは同じディレクトリを共有するので、同じソースを両方が
# 持つと同じ経路を2つの規則が作ることになる。落ちるのは実行の段で、
# しかも **ninja の言葉で**出る（docs/10-findings.md F-052）。
[lib.foo]
sources = [file("src/shared.c")]

[bin.foo]
sources = [file("src/shared.c"), file("src/main.c")]

[bin.foo.private]
deps = [target("foo")]
