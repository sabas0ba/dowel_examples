# `tc.<道具>` は構成の語彙である。宣言によって具体化が変わらなければ、
# 複数のツールチェーンに対応するマニフェストは書けない。
#
# host/ とは別のパッケージにしてある。翻訳が tc.ar に依存していると、
# archiver を差し替えたときに翻訳まで走るのが正しい挙動になってしまい、
# 「道具の変更がどこまで波及するか」を host/ で測れなくなる。
[lib.vocab]
sources = [file("src/vocab.c")]

[lib.vocab.private]
defines = { AR_IS = match tc.ar { "gcc-ar" => 2, _ => 1 } }
