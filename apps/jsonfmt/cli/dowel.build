[bin.jsonfmt]
sources = glob("src/*.c")

[bin.jsonfmt.private]
deps  = [dep("jsonfmt-core")]
flags = [
    "-std=gnu11", "-Wall", "-Wextra",
    "-fsanitize=address,undefined" when feature.sanitize,
]
abi   = "gnu11"

[test.cli]
sources = [file("../tests/cli.c")]

[test.cli.private]
deps  = [dep("jsonfmt-core")]
flags = [
    "-std=gnu11",
    "-fsanitize=address,undefined" when feature.sanitize,
]
abi   = "gnu11"
