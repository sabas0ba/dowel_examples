# 配ることを前提にしたライブラリ。利用者は別のパッケージであり、C からも
# C++ からも呼ぶ。したがって見出しは `extern "C"` を持ち、公開する名前は
# `hashx_` で始まるものだけである。
[lib.hashx]
sources = [
    file("src/fnv.c"),
    file("src/crc32.c"),
    file("src/version.c"),
]

# 共有として配る版。`exports` に既定は無く、省くと `missing-exports` で
# 拒まれる（ADR-0030）。既定を置かないのは、**平面ごとに意味が逆だから**
# である——ELF と Mach-O では `static` でない名前がすべて出るが、Windows
# では何も出ない。どちらを既定にしても、同じマニフェストが2つの違う面を
# 記述することになる。だから一覧を要求し、リンカごとの形（version script /
# シンボル一覧 / `.def`）はその1つの宣言から作る。
#
# 名前はリンカが見るとおりに書く。ここは C なので関数名そのままである。
linkage = "shared" when feature.shared
# 名前は**そのまま**一致する。接頭辞ではない——`hashx_crc` と書いても
# `hashx_crc_end` は出ない（`hashx_crc` はそもそも型であって記号ではない）。
# 書き落とせば、使う側のリンクで `undefined reference` として出る。
exports = [
    "hashx_fnv1a",
    "hashx_crc32",
    "hashx_crc_begin",
    "hashx_crc_feed",
    "hashx_crc_end",
    "hashx_version",
] when feature.shared

[lib.hashx.public]
includes = [dir("include")]
# この面は C ABI である。見出しは `extern "C"` で囲ってあり、境界を跨いだ
# 呼び出しに ODR の危険は無い。`c` はどの札とも合う（F-028）。
abi      = "c"

[lib.hashx.private]
includes = [dir("src")]
# 既定で隠し、公開する名前にだけ属性で印を付ける。ライブラリの面を
# 「書いたつもり」ではなく成果物の側で決めるための指定である。
flags    = [
    "-std=gnu11", "-Wall", "-Wextra", "-Werror=missing-prototypes",
    "-fvisibility=hidden",
]
defines  = {
    HASHX_SMALL_TABLE = 1 when feature.small,
    # 版はここから届く。見出しに書き写さない（F-030）。
    HASHX_VERSION     = pkg.version,
}

[test.unit]
sources = [file("../tests/unit.c")]

[test.unit.private]
deps     = [target("hashx")]
includes = [dir("src")]
flags    = ["-std=gnu11"]
abi      = "gnu11"
# テストも版を知る。ライブラリが答える版がパッケージの版であることを、
# 手で写した値ではなくマニフェストの値と突き合わせる。
defines  = { HASHX_VERSION = pkg.version }
