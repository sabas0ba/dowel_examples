# 配ることを前提にしたライブラリ。利用者は別のパッケージであり、C からも
# C++ からも呼ぶ。したがって見出しは `extern "C"` を持ち、公開する名前は
# `hashx_` で始まるものだけである。
[lib.hashx]
sources = [
    file("src/fnv.c"),
    file("src/crc32.c"),
    file("src/version.c"),
]

[lib.hashx.public]
includes = [dir("include")]
# この面は C ABI である。見出しは `extern "C"` で囲ってあり、境界を跨いだ
# 呼び出しに ODR の危険は無い。`c` はどの札とも合う（F-028）。
abi      = "c"

[lib.hashx.private]
includes = [dir("src")]
# 既定で隠し、公開する名前にだけ属性で印を付ける。ライブラリの面を
# 「書いたつもり」ではなく成果物の側で決めるための指定である。
flags    = [
    "-std=gnu11", "-Wall", "-Wextra", "-Werror=missing-prototypes",
    "-fvisibility=hidden",
]
defines  = {
    HASHX_SMALL_TABLE = 1 when feature.small,
    # 版はここから届く。見出しに書き写さない（F-030）。
    HASHX_VERSION     = pkg.version,
}

[test.unit]
sources = [file("../tests/unit.c")]

[test.unit.private]
deps     = [target("hashx")]
includes = [dir("src")]
flags    = ["-std=gnu11"]
abi      = "gnu11"
# テストも版を知る。ライブラリが答える版がパッケージの版であることを、
# 手で写した値ではなくマニフェストの値と突き合わせる。
defines  = { HASHX_VERSION = pkg.version }
