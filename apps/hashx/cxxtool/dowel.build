# C++ の利用者。C のライブラリを配る以上、これが繋がらなければ意味が無い。
#
# 自分の言語を書く。ライブラリの面は `abi = "c"` を名乗っており、
# C ABI の境界はどの札とも合う（docs/10-findings.md F-028）。
[bin.hashcxx]
sources = [file("src/main.cpp")]

[bin.hashcxx.private]
deps      = [dep("hashx")]
flags     = ["-Wall", "-Wextra"]
cxx_flags = ["-std=gnu++17"]
abi       = "gnu++17"
