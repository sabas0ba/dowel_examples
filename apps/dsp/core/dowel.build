# 算法。1つのソースが4つの三つ組へ組まれる。
#
#   x86_64-unknown-linux-gnu       手元。cli と gui が使う
#   aarch64-unknown-linux-gnu      ARM。qemu-user で走らせる
#   riscv64gc-unknown-linux-gnu    RISC-V。同上
#   thumbv7em-none-eabihf          Cortex-M4F。OS も libc も無い（fw/ が使う）
#
# 三つ組ごとに変わるのは**旗と ABI ラベルだけ**である。ソースは1つで、
# `#ifdef` は1つも無い。算法の側が機械を知らないから、「どの三つ組でも
# 同じ答が出る」ことを検査にできる。
#
# 分岐は `target.os` で書く。書きたいのは「OS が無い側なら freestanding」で
# あって「この三つ組なら」ではない。以前は対象の OS を指す語が無く、三つ組を
# 数え上げていた（F-053）。数え上げは腕が対象の数だけ増えるうえ、`_` が既定
# なので**書き忘れた三つ組が静かにホスト側の腕へ落ちる**。`target.os` は
# 有限領域なので、腕の網羅性は検査される。

[lib.dsp]
sources = [
    file("src/biquad.c"),
    file("src/crc32.c"),
]

[lib.dsp.public]
includes = [dir("include")]
# ABI ラベルも三つ組で変わる。ベアメタルの側は浮動小数の渡し方が別なので、
# ホスト向けと同じラベルを名乗らせない。名乗らせると、取り違えた組み合わせが
# `abi-mismatch` ではなくリンカの苦情として出る。
abi = match target.os {
    none => "thumbv7em-hard",
    _    => "gnu11",
}

[lib.dsp.private]
c_std = "c11"
flags = match target.os {
    # OS の無い側。標準ライブラリの存在を仮定させず、CPU と浮動小数の
    # 渡し方を名指しする。ここが揃っていないと、使う側（fw）と別の
    # 呼び出し規約で組まれた書庫ができる。
    none => [
        "-Wall", "-Wextra",
        "-mcpu=cortex-m4", "-mthumb", "-mfloat-abi=hard", "-mfpu=fpv4-sp-d16",
        "-ffreestanding", "-fno-builtin",
    ],
    # OS の載っている側。機械ごとの旗は要らない——三つ組を渡された
    # コンパイラが自分で正しく選ぶ。それが `[toolchain.<triple>]` に
    # 別のコンパイラを書く意味である。
    _ => ["-Wall", "-Wextra"],
}

# 算法の検査。**この1本がホストの載っている3つの三つ組すべてで走る。**
#
#   dowel test                                        x86_64
#   dowel test --target=aarch64-unknown-linux-gnu     ARM
#   dowel test --target=riscv64gc-unknown-linux-gnu   RISC-V
#
# ベアメタルの側は libc が無いので、この実体（stdio を使う）は組めない。
# **それを目標ごとの `targets` で言う。** 書けなかった頃は、ベアメタル向けの
# 構成でもこの目標が計画に入り、使う側（fw）の build がここで落ちていた
# （F-055）。`[package] targets` はパッケージ全体に掛かるので使えない——
# このパッケージは4つすべてへ組まれる必要がある。
#
# 同じ期待値を同じ見出し（tests/golden.h）から読む別の実体を fw/ が持つ。
[test.vectors]
sources = [file("../tests/vectors.c")]
targets = [
    "x86_64-unknown-linux-gnu",
    "aarch64-unknown-linux-gnu",
    "riscv64gc-unknown-linux-gnu",
]

[test.vectors.private]
deps     = [target("dsp")]
includes = [dir("../tests")]
c_std    = "c11"
flags    = ["-Wall", "-Wextra"]
# この目標はベアメタルの三つ組では計画に現れないので、ラベルは1つでよい。
# `targets` を書く前は、組まない三つ組でも ABI ラベルが突き合わされるため、
# ここも `lib.dsp` と同じ `match` にしておく必要があった。
abi = "gnu11"

[test.vectors.cases]
signal   = { args = ["signal"] }
filter   = { args = ["filter"] }
smooth   = { args = ["smooth"] }
saturate = { args = ["saturate"] }
stream   = { args = ["stream"] }

# 走らせる側。どちらも qemu-user である。動的リンクの成果物なので、
# その三つ組の系の根を教えないと読み込み器が見つからない。
[runner.aarch64-unknown-linux-gnu]
command = "qemu-aarch64-static"
args    = ["-L", "/usr/aarch64-linux-gnu"]

[runner.riscv64gc-unknown-linux-gnu]
command = "qemu-riscv64-static"
args    = ["-L", "/usr/riscv64-linux-gnu"]
