# 行末と経路。答が構成ごとに違う二つを、1枚の見出しの裏で切り替える。
#
# ライブラリの名前が `wtcore` で実行ファイルが `wt` なのは、避けたのであって
# 選んだのではない。両方を `wt` と名乗ると、かつては `dowel check` が通って
# しまい、`public` はどこにも伝播せず、ソースを共有した側はオブジェクトの
# 経路が衝突して ninja の言葉で落ちた（[F-052](../../../docs/10-findings.md#f-052)）。
# いまは `duplicate-target` で拒まれるので、名前を割るのは回避ではなく規則で
# ある——名前は `target()`・ラベル・`obj/` の3か所で鍵として使われている。
#
# 切り替えは `match target.os` で書く。欲しいのは「対象が Windows なら」で
# あって「対象がこの三つ組なら」ではない。以前は語彙に対象を指す語が無く、
# 三つ組を数え上げていた（F-053）。数え上げは Windows の三つ組が複数ある
# ぶん腕が増え、しかも `_` が既定なので**書き忘れた三つ組が静かに POSIX 側へ
# 落ちる**。`target.os` は有限領域なので、腕の網羅性は検査される。
#
# なお `host.os` は組む側を指す。素直にそちらへ分岐すると、Windows 向けに
# 組んでいるのに POSIX の実装が選ばれる——語が2つ揃って初めて書き分けられる。
[lib.wtcore]
sources = [
    file("src/text.c"),
    match target.os {
        windows => file("src/plat_win.c"),
        _       => file("src/plat_posix.c"),
    },
]

[lib.wtcore.public]
includes = [dir("include")]
abi      = "gnu11"

[lib.wtcore.private]
includes = [dir("src")]
flags    = ["-Wall", "-Wextra"]
c_std    = "c11"

[bin.wt]
sources = [file("src/main.c")]

[bin.wt.private]
deps  = [target("wtcore")]
flags = ["-Wall", "-Wextra"]
c_std = "c11"
abi   = "gnu11"

[test.unit]
sources = [file("../tests/unit.c")]

[test.unit.private]
deps  = [target("wtcore")]
flags = ["-Wall", "-Wextra"]
c_std = "c11"
abi   = "gnu11"

[test.unit.cases]
eol  = { args = ["eol"] }
sep  = { args = ["sep"] }
base = { args = ["base"] }
norm = { args = ["norm"] }

# 組んだものを走らせる側。手元の機械に Windows は無いので wine を通す。
# 宣言はこれで足りているが、渡される経路に `.exe` が付かないため今は
# 起動できない（[F-050](../../../docs/10-findings.md#f-050)）。
[runner.x86_64-pc-windows-gnu]
command = "wine"
