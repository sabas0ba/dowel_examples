# Cortex-M4F 向けのファームウェア。対象は MPS2-AN386。
#
# 対象を増やす（RISC-V など）ときに変わるのは3つだけである。
#
#   1. `dowel.toml` に `[toolchain.<triple>]` を1つ足す
#   2. `ld/<triple>.ld` を置く
#   3. cpu と ABI の指定を `match cfg.target` の腕にする
#
# なお現状、対象そのものを宣言する手段が無い。--target を付け忘れると
# ホスト向けの計画が立つ（docs/10-findings.md F-026）。

# 機械の旗は、この木の3つの目標すべてに要る。以前は3か所へ書き写して
# いた——同じ値でなければ呼び出し規約の違うものが混ざるのに、揃っている
# ことを確かめる手立ては無かった。`template` がそれを1か所にする
# （ADR-0035）。
#
# `template` は目標ではない。`sources` も `linkage` も書けず、成果物も
# 出さず、グラフにも現れない。**設定だけ**を持つ。
#
# 展開は「元の塊へ」入る。`private` は使う側の `private` に、`public` は
# `public` になる。ソースを持たないライブラリでは代われない——`public` だけが
# 伝播するので、依存を通して設定を配ると下流すべてへ公開することになる。
[template.cortex_m4f]

[template.cortex_m4f.private]
flags = [
    "-mcpu=cortex-m4", "-mthumb", "-mfloat-abi=hard", "-mfpu=fpv4-sp-d16",
    "-ffreestanding",       # 標準ライブラリの存在を仮定しない
    "-fno-builtin",         # memcpy 等への置き換えを禁じる
    "-nostdinc",            # 系の見出しを探しに行かせない
    "-Wall", "-Wextra",
]
# 方言は C のものである。以前は上の一覧に `-std=gnu11` を混ぜていた。
# ソースが C だけのうちは同じことだったが、起動コードを `.S` へ移した
# 時点で、それは C でないファイルに C の方言を告げる指定になった
# （ADR-0048）。**言語ごとの置き場が在るのは、このためである。**
#
# `c_std` は ISO の名前しか受けない（c89 / c99 / c11 / c17 / c23）。
# この木が要るのは GNU 方言なので、C 専用の一覧の側に置く。
c_flags = ["-std=gnu11"]

# リンクする2つの目標が使う。書庫を作るだけの lib.bl には要らない。
[template.cortex_m4f_link]

[template.cortex_m4f_link.private]
link_flags = [
    "-mcpu=cortex-m4", "-mthumb", "-mfloat-abi=hard", "-mfpu=fpv4-sp-d16",
    "-nostdlib",            # 起動コードも libc も付けない
    "-static",
    "-Wl,--build-id=none",
    "-Wl,-e,_reset",        # 入口はベクタ表の [1] が指す先
    # 記憶の配置。link_flags は Str と Path を受けるので、木の中の
    # スクリプトをそのまま指せる。リンクはビルドディレクトリで走るため、
    # 相対の文字列では届かない。
    "-T", file("ld/thumbv7em-none-eabihf.ld"),
]

[lib.bl]
use     = [template("cortex_m4f")]
sources = [
    file("src/gpio.c"),
    file("src/delay.c"),
    file("src/semihost.c"),
]

[lib.bl.public]
includes = [dir("include")]
abi      = "thumbv7em-hard"

# 実体。ベクタ表と入口を持ち、止まらずに回り続ける。
[bin.firmware]
use     = [template("cortex_m4f"), template("cortex_m4f_link")]
sources = [
    file("src/vectors.S"),
    file("src/main.c"),
]

[bin.firmware.private]
deps  = [target("bl")]
abi   = "thumbv7em-hard"

# 書き込み用の像。ELF のままでは書き込み器が読めない。
[bin.firmware.artifacts]
bin = { tool = "objcopy", args = ["-O", "binary"] }
hex = { tool = "objcopy", args = ["-O", "ihex"] }

# 実機（の代わりの qemu）で走るテスト。結果は semihosting で返す。
# ホスト向けに組んだものを走らせても、周辺機器の番地も命令集合も違う。
[test.onhw]
use     = [template("cortex_m4f"), template("cortex_m4f_link")]
sources = [file("tests/onhw.c")]

[test.onhw.private]
deps  = [target("bl")]
abi   = "thumbv7em-hard"

# 実行の仕方。`[runner.<triple>]` は **dowel.build** の表である
# （dowel.toml へ書くと `unknown-table` で拒まれる。docs/10-findings.md F-027）。
#
# 成果物の道は実装が末尾に付ける（ADR-0008）。したがって `-kernel` を
# args の最後に置けば `qemu-system-arm ... -kernel <artifact>` になる。
[runner.thumbv7em-none-eabihf]
command = "qemu-system-arm"
args    = ["-M", "mps2-an386", "-nographic", "-semihosting", "-kernel"]
# 保持する側と繋ぐ側（ADR-0024）。qemu-system は -gdb でスタブを開き、
# -S で最初の命令の前に止まる。
#
# ただし現状、スタブの引数は args と成果物の間に挿し込まれるため、
# `-kernel` が `-gdb` を食ってしまい、この宣言では繋がらない
# （docs/10-findings.md F-046）。
debug_args    = ["-gdb", "tcp::13579", "-S"]
debug_connect = "localhost:13579"
